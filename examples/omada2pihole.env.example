# Copy to omada2pihole.env and fill in. Never commit the real file.
# Every option is described in docs/configuration.md.

OMADA_URL=https://omada.local:8043
OMADA_ID=
OMADA_CLIENT_ID=
OMADA_CLIENT_SECRET=
OMADA_SITE=Default
# OMADA_TLS_SKIP_VERIFY=true   # self-signed controller certificate
# OMADA_CA_FILE=/ca.pem

PIHOLE_URL=https://pi.hole
PIHOLE_PASSWORD=
# PIHOLE_TLS_SKIP_VERIFY=true
# PIHOLE_CA_FILE=/ca.pem

DOMAIN_SUFFIX=lan
SYNC_INTERVAL=5m
DRY_RUN=false
